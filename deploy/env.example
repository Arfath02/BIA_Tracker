# Copy to deploy/.env, chmod 600, and replace values. Never commit it.
# Percent-encode any reserved password characters in the URL.
DATABASE_URL=mssql+pyodbc://bia_app:REPLACE_WITH_SECRET@SQLSERVER_INTERNAL_FQDN:1433/BIA_Transformation?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
TRUSTED_ORIGINS=https://YOUR_INTERNAL_FQDN:8443
# Select an internal LAN IP after approval; the safe default is loopback.
BIND_IP=127.0.0.1
TLS_DIRECTORY=/etc/bia-transform/tls

# External HTTPS port; keep TRUSTED_ORIGINS in sync.
APP_PORT=8443
