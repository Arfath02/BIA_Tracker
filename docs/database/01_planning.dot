digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
departments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
master_projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>master_projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="primaryDepartmentId" ALIGN="LEFT">primaryDepartmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="owner" ALIGN="LEFT">owner</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="owner" ALIGN="LEFT">owner</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="budget" ALIGN="LEFT">budget</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="color" ALIGN="LEFT">color</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
tasks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>tasks</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="parentId" ALIGN="LEFT">parentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="assigneeId" ALIGN="LEFT">assigneeId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="resourceId" ALIGN="LEFT">resourceId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="effort" ALIGN="LEFT">effort</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="progress" ALIGN="LEFT">progress</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="blocked" ALIGN="LEFT">blocked</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
resources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>resources</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
task_predecessors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>task_predecessors</B></FONT></TD></TR><TR><TD PORT="taskId" ALIGN="LEFT">taskId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="predecessorId" ALIGN="LEFT">predecessorId</TD><TD ALIGN="LEFT">PK FK</TD></TR></TABLE>>];
progress_updates [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>progress_updates</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="taskId" ALIGN="LEFT">taskId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="progress" ALIGN="LEFT">progress</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="note" ALIGN="LEFT">note</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="authorId" ALIGN="LEFT">authorId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="author" ALIGN="LEFT">author</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="createdAt" ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
master_projects -> departments [label="primaryDepartmentId\n0..* to 0..1"];
projects -> users [label="createdById\n0..* to 0..1"];
projects -> departments [label="departmentId\n0..* to 1"];
projects -> master_projects [label="masterId\n0..* to 1"];
tasks -> users [label="assigneeId\n0..* to 0..1"];
tasks -> tasks [label="parentId\n0..* to 0..1"];
tasks -> projects [label="projectId\n0..* to 1"];
tasks -> resources [label="resourceId\n0..* to 1"];
task_predecessors -> tasks [label="predecessorId\n0..* to 1"];
task_predecessors -> tasks [label="taskId\n0..* to 1"];
progress_updates -> users [label="authorId\n0..* to 0..1"];
progress_updates -> tasks [label="taskId\n0..* to 1"];
users -> departments [label="departmentId\n0..* to 1"];
}