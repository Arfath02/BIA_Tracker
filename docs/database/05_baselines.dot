digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
tasks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>tasks</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="parentId" ALIGN="LEFT">parentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="assigneeId" ALIGN="LEFT">assigneeId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="resourceId" ALIGN="LEFT">resourceId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="effort" ALIGN="LEFT">effort</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="progress" ALIGN="LEFT">progress</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="blocked" ALIGN="LEFT">blocked</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
task_milestones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>task_milestones</B></FONT></TD></TR><TR><TD PORT="taskId" ALIGN="LEFT">taskId</TD><TD ALIGN="LEFT">PK FK</TD></TR></TABLE>>];
project_baselines [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>project_baselines</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdBy" ALIGN="LEFT">createdBy</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="createdAt" ALIGN="LEFT">createdAt</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
baseline_tasks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>baseline_tasks</B></FONT></TD></TR><TR><TD PORT="baselineId" ALIGN="LEFT">baselineId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="taskId" ALIGN="LEFT">taskId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="parentId" ALIGN="LEFT">parentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="effort" ALIGN="LEFT">effort</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="isMilestone" ALIGN="LEFT">isMilestone</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
project_days_off [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>project_days_off</B></FONT></TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="weekday" ALIGN="LEFT">weekday</TD><TD ALIGN="LEFT">PK </TD></TR></TABLE>>];
projects -> users [label="createdById\n0..* to 0..1"];
tasks -> users [label="assigneeId\n0..* to 0..1"];
tasks -> tasks [label="parentId\n0..* to 0..1"];
tasks -> projects [label="projectId\n0..* to 1"];
task_milestones -> tasks [label="taskId\n0..1 to 1"];
project_baselines -> users [label="createdById\n0..* to 1"];
project_baselines -> projects [label="projectId\n0..* to 1"];
baseline_tasks -> project_baselines [label="baselineId\n0..* to 1"];
baseline_tasks -> tasks [label="parentId\n0..* to 0..1"];
baseline_tasks -> tasks [label="taskId\n0..* to 1"];
project_days_off -> projects [label="projectId\n0..* to 1"];
}