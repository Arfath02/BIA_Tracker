digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
project_finance [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>project_finance</B></FONT></TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="currency" ALIGN="LEFT">currency</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="usdRate" ALIGN="LEFT">usdRate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="rateDate" ALIGN="LEFT">rateDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="vendorId" ALIGN="LEFT">vendorId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
currency_codes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>currency_codes</B></FONT></TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="digits" ALIGN="LEFT">digits</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
vendors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>vendors</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
vendor_consultants [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>vendor_consultants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="vendorId" ALIGN="LEFT">vendorId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="ownerProjectId" ALIGN="LEFT">ownerProjectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
consultant_trips [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>consultant_trips</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="consultantId" ALIGN="LEFT">consultantId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="end" ALIGN="LEFT">end</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaFlight" ALIGN="LEFT">biaFlight</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaAccommodation" ALIGN="LEFT">biaAccommodation</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaFood" ALIGN="LEFT">biaFood</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="stayType" ALIGN="LEFT">stayType</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="flightBooked" ALIGN="LEFT">flightBooked</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="flightCost" ALIGN="LEFT">flightCost</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="bookedDate" ALIGN="LEFT">bookedDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="notes" ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
payment_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>payment_terms</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="trigger" ALIGN="LEFT">trigger</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="dueDate" ALIGN="LEFT">dueDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="milestoneId" ALIGN="LEFT">milestoneId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="cancelled" ALIGN="LEFT">cancelled</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
invoice_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoice_terms</B></FONT></TD></TR><TR><TD PORT="invoiceId" ALIGN="LEFT">invoiceId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="termId" ALIGN="LEFT">termId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="poId" ALIGN="LEFT">poId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="date" ALIGN="LEFT">date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
tasks [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>tasks</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="parentId" ALIGN="LEFT">parentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="assigneeId" ALIGN="LEFT">assigneeId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="resourceId" ALIGN="LEFT">resourceId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="effort" ALIGN="LEFT">effort</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="progress" ALIGN="LEFT">progress</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="blocked" ALIGN="LEFT">blocked</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
project_finance -> currency_codes [label="currency\n0..* to 1"];
project_finance -> projects [label="projectId\n0..1 to 1"];
project_finance -> vendors [label="vendorId\n0..* to 0..1"];
vendor_consultants -> projects [label="ownerProjectId\n0..* to 0..1"];
vendor_consultants -> vendors [label="vendorId\n0..* to 1"];
consultant_trips -> vendor_consultants [label="consultantId\n0..* to 1"];
consultant_trips -> projects [label="projectId\n0..* to 1"];
payment_terms -> projects [label="projectId\n0..* to 1"];
payment_terms -> tasks [label="milestoneId\n0..* to 0..1"];
invoice_terms -> invoices [label="invoiceId\n0..1 to 1"];
invoice_terms -> payment_terms [label="termId\n0..* to 1"];
tasks -> tasks [label="parentId\n0..* to 0..1"];
tasks -> projects [label="projectId\n0..* to 1"];
}