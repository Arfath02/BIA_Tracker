digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
budget_change_requests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>budget_change_requests</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="requestedById" ALIGN="LEFT">requestedById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="requestedBy" ALIGN="LEFT">requestedBy</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="requestedDate" ALIGN="LEFT">requestedDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="decidedById" ALIGN="LEFT">decidedById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="decidedBy" ALIGN="LEFT">decidedBy</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="decisionDate" ALIGN="LEFT">decisionDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="decisionNote" ALIGN="LEFT">decisionNote</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="budgetBefore" ALIGN="LEFT">budgetBefore</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="budgetAfter" ALIGN="LEFT">budgetAfter</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="poId" ALIGN="LEFT">poId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="date" ALIGN="LEFT">date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
invoice_budget_changes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoice_budget_changes</B></FONT></TD></TR><TR><TD PORT="invoiceId" ALIGN="LEFT">invoiceId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="changeRequestId" ALIGN="LEFT">changeRequestId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
projects -> users [label="createdById\n0..* to 0..1"];
budget_change_requests -> users [label="decidedById\n0..* to 0..1"];
budget_change_requests -> projects [label="projectId\n0..* to 1"];
budget_change_requests -> users [label="requestedById\n0..* to 1"];
invoice_budget_changes -> budget_change_requests [label="changeRequestId\n0..* to 1"];
invoice_budget_changes -> invoices [label="invoiceId\n0..1 to 1"];
}