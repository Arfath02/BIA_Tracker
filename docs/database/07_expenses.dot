digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
vendor_consultants [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>vendor_consultants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="vendorId" ALIGN="LEFT">vendorId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="ownerProjectId" ALIGN="LEFT">ownerProjectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
consultant_details [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>consultant_details</B></FONT></TD></TR><TR><TD PORT="consultantId" ALIGN="LEFT">consultantId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="designation" ALIGN="LEFT">designation</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
consultant_trips [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>consultant_trips</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="consultantId" ALIGN="LEFT">consultantId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="start" ALIGN="LEFT">start</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="end" ALIGN="LEFT">end</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaFlight" ALIGN="LEFT">biaFlight</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaAccommodation" ALIGN="LEFT">biaAccommodation</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="biaFood" ALIGN="LEFT">biaFood</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="stayType" ALIGN="LEFT">stayType</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="flightBooked" ALIGN="LEFT">flightBooked</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="flightCost" ALIGN="LEFT">flightCost</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="bookedDate" ALIGN="LEFT">bookedDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="notes" ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
trip_costs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>trip_costs</B></FONT></TD></TR><TR><TD PORT="tripId" ALIGN="LEFT">tripId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="flightCostJod" ALIGN="LEFT">flightCostJod</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="hotelBookedBy" ALIGN="LEFT">hotelBookedBy</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="hotelCostJod" ALIGN="LEFT">hotelCostJod</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="visaCostJod" ALIGN="LEFT">visaCostJod</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
project_expenses [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>project_expenses</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="date" ALIGN="LEFT">date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="prNumber" ALIGN="LEFT">prNumber</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amountJod" ALIGN="LEFT">amountJod</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="remarks" ALIGN="LEFT">remarks</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
vendor_consultants -> projects [label="ownerProjectId\n0..* to 0..1"];
consultant_details -> vendor_consultants [label="consultantId\n0..1 to 1"];
consultant_trips -> vendor_consultants [label="consultantId\n0..* to 1"];
consultant_trips -> projects [label="projectId\n0..* to 1"];
trip_costs -> consultant_trips [label="tripId\n0..1 to 1"];
project_expenses -> projects [label="projectId\n0..* to 1"];
}