digraph BIA {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.7", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#6c7a89", arrowsize=0.8];
projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>projects</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="masterId" ALIGN="LEFT">masterId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="createdById" ALIGN="LEFT">createdById</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
vendors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>vendors</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
purchase_orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>purchase_orders</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="projectId" ALIGN="LEFT">projectId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="vendorId" ALIGN="LEFT">vendorId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="date" ALIGN="LEFT">date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="poId" ALIGN="LEFT">poId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="amount" ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="date" ALIGN="LEFT">date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="due" ALIGN="LEFT">due</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
invoice_payments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>invoice_payments</B></FONT></TD></TR><TR><TD PORT="invoiceId" ALIGN="LEFT">invoiceId</TD><TD ALIGN="LEFT">PK FK</TD></TR><TR><TD PORT="reference" ALIGN="LEFT">reference</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="paidDate" ALIGN="LEFT">paidDate</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD PORT="recordedById" ALIGN="LEFT">recordedById</TD><TD ALIGN="LEFT">FK</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#15354b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK </TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="departmentId" ALIGN="LEFT">departmentId</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
projects -> users [label="createdById\n0..* to 0..1"];
purchase_orders -> projects [label="projectId\n0..* to 1"];
purchase_orders -> vendors [label="vendorId\n0..* to 1"];
invoices -> purchase_orders [label="poId\n0..* to 1"];
invoice_payments -> invoices [label="invoiceId\n0..1 to 1"];
invoice_payments -> users [label="recordedById\n0..* to 0..1"];
}