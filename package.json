{
  "name": "bia-transformation-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && esbuild server/worker.js --bundle --format=esm --platform=browser --outfile=dist/worker.js && node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "preview": "node scripts/preview.mjs",
    "test:api": "node tests/api.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:admin": "node tests/admin-api.mjs",
    "test:masters": "node tests/masters-api.mjs",
    "test:access": "node tests/access-api.mjs",
    "test:management": "node tests/management-api.mjs",
    "test:auth-ui": "node tests/auth-ui.mjs",
    "test:baseline-ui": "node tests/baseline-ui.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.3.1",
    "esbuild": "0.28.1",
    "wrangler": "4.92.0",
    "miniflare": "4.20260515.0",
    "jsdom": "30.1.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1",
      "ws": "8.21.0"
    },
    "esbuild": "$esbuild"
  }
}
