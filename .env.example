# ==============================================================================
# BIA Project Portfolio & Transformation Tracker - Environment Configuration
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Microsoft SQL Server Database Configuration
MSSQL_PASSWORD=YourStrongPasswordHere!123
MSSQL_DATABASE=BIA_Transformation
MSSQL_USERNAME=sa
# Host port mapping for SQL Server (use 14333 if port 1433 is already in use on your host)
MSSQL_HOST_PORT=14333
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Application Web Port (Default: 5050 to avoid Jenkins/8080 conflicts)
APP_PORT=5050

# Trusted Origins (Comma-separated list of origins permitted for API mutations)
# Include your server's IP/hostname and port 5050
TRUSTED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050,http://your-server-ip:5050
